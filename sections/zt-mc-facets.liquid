  {%- paginate collection.products by section.settings.per_page -%}
    <form class="facets" action="{{ collection.url }}" method="get" data-facets>
      <div class="facets__bar">
        <div class="facets__filters">
          {%- if st.show_filters -%}
            {%- for filter in collection.filters -%}
              {%- assign active_count = filter.active_values.size -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign active_count = 1 -%}{%- endif -%}
              {%- endif -%}
              <details class="facet" data-facet>
                <summary class="facet__summary">
                  <span>{{ filter.label | escape }}{% if active_count > 0 %} <b class="facet__count">{{ active_count }}</b>{% endif %}</span>
                  {% render 'icon', name: 'chevron-down', px: 14 %}
                </summary>
                <div class="facet__panel">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <div class="facet__price">
                        <label><span>Od €</span><input type="number" inputmode="numeric" min="0" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}" placeholder="0"></label>
                        <label><span>Do €</span><input type="number" inputmode="numeric" min="0" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}" placeholder="{{ filter.range_max | divided_by: 100 }}"></label>
                      </div>
                      <button type="submit" class="btn btn--sm btn--sans facet__apply">{{ 'collections.apply' | t }}</button>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="facet__check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                          <span class="facet__box">{% render 'icon', name: 'check', px: 12, sw: 2.4 %}</span>
                          <span class="facet__label">{{ value.label | escape }}</span>
                          <span class="facet__num">{{ value.count }}</span>
                        </label>
                      {%- endfor -%}
                      <noscript><button type="submit" class="btn btn--sm btn--sans">{{ 'collections.apply' | t }}</button></noscript>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="facets__right">
          <span class="facets__total">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
          {%- if st.show_sort -%}
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <label class="facet-sort">
              <span class="visually-hidden">{{ 'collections.sort' | t }}</span>
              <select name="sort_by" data-sort>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
              </select>
              {% render 'icon', name: 'chevron-down', px: 14 %}
            </label>
          {%- endif -%}
        </div>
      </div>

      {%- liquid
        assign any_active = false
        for filter in collection.filters
          if filter.active_values.size > 0
            assign any_active = true
          endif
          if filter.type == 'price_range'
            if filter.min_value.value != nil or filter.max_value.value != nil
              assign any_active = true
            endif
          endif
        endfor
      -%}
      {%- if any_active -%}
        <div class="facets__active">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="chip chip--active" href="{{ value.url_to_remove }}">{{ filter.label | escape }}: {{ value.label | escape }} {% render 'icon', name: 'close', px: 12 %}</a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <a class="chip chip--active" href="{{ filter.url_to_remove }}">
                  {{- filter.label | escape }}: {% if filter.min_value.value %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %} – {% if filter.max_value.value %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %} {% render 'icon', name: 'close', px: 12 -%}
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="facets__clear" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}">{{ 'collections.clear' | t }}</a>
        </div>
      {%- endif -%}
    </form>

  {%- endpaginate -%}
{% schema %}
{"name":"T","settings":[{"type":"range","id":"per_page","label":"P","min":8,"max":48,"step":4,"default":24}]}
{% endschema %}
