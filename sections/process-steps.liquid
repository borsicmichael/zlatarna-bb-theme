{%- liquid
  assign s = section.settings
  assign sel = '#shopify-section-' | append: section.id
-%}
{% render 'section-style', id: section.id, s: s, h: '.process__head h2', b: '.process__head p:not(.eyebrow)' %}
{%- style -%}
  {{ sel }} .steps { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: s.columns }}, minmax(0,1fr)); {% if s.line_color != blank %}border-top-color: {{ s.line_color }};{% endif %} {% unless s.show_lines %}border-top: 0;{% endunless %} }
  {%- if s.line_color != blank %}{{ sel }} .step + .step { border-left-color: {{ s.line_color }}; }{% endif %}
  {%- unless s.show_lines %}{{ sel }} .step + .step { border-left: 0; }{% endunless %}
  {{ sel }} .step__num { font-size: {{ s.num_size }}px; {% if s.num_color != blank %}color: {{ s.num_color }};{% endif %} }
  {%- unless s.show_numbers %}{{ sel }} .step__num { display: none; }{% endunless %}
  {{ sel }} .step__title { font-size: {{ s.step_title_size }}px; {% if s.s_heading != blank %}color: {{ s.s_heading }};{% endif %} }
  {{ sel }} .step__text { font-size: {{ s.step_text_size }}px; }
  {{ sel }} .step__icon { width: 64px; height: 64px; object-fit: contain; }
  {{ sel }} .process { gap: {{ s.block_gap }}px; }
  @media (max-width: 749px) {
    {{ sel }} .steps { grid-template-columns: 1fr; }
    {{ sel }} .step__num { font-size: {{ s.num_size_mobile }}px; }
    {{ sel }} .step__title { font-size: {{ s.step_title_size_mobile }}px; }
    {{ sel }} .step__text { font-size: {{ s.step_text_size_mobile }}px; }
    {{ sel }} .process { gap: 24px; }
    {%- if s.show_text_mobile %}{{ sel }} .process__head p:not(.eyebrow) { display: block; }{% endif %}
    {%- if s.show_button2_mobile %}{{ sel }} .process__buttons .btn + .btn { display: inline-flex; }{% endif %}
  }
{%- endstyle -%}
<section>
  <div class="page-width process">
    <div class="process__head s-align">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h-display">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon | image_url: width: 200 | image_tag: class: 'step__icon', loading: 'lazy', alt: '' }}
          {%- endif -%}
          <span class="step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="step__body">
            <h3 class="step__title">{{ block.settings.title | escape }}</h3>
            <p class="step__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.button_1_label != blank or s.button_2_label != blank -%}
      <div class="process__buttons">
        {%- if s.button_1_label != blank -%}
          <a class="btn" href="{{ s.button_1_url | default: '#' }}">
            {%- if s.button_1_url contains 'tel:' -%}{% render 'icon', name: 'phone', px: 16 %}{%- endif -%}
            {{- s.button_1_label | escape -}}
          </a>
        {%- endif -%}
        {%- if s.button_2_label != blank -%}
          <a class="btn btn--outline" href="{{ s.button_2_url | default: '#' }}">{{ s.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Postopek (koraki)",
  "class": "section-process",
  "settings": [
    {"type": "header", "content": "Vsebina"},
    {"type": "text", "id": "eyebrow", "label": "Nadnaslov", "default": "Nakit po naročilu"},
    {"type": "inline_richtext", "id": "heading", "label": "Naslov", "default": "V poplavi izdelkov poskrbimo za tiste <em>prave</em>."},
    {"type": "textarea", "id": "text", "label": "Besedilo", "default": "Visoka kakovost, ročna izdelava in slovensko poreklo. Od prve ideje do končnega kosa – z vami je zlatarski mojster."},
    {"type": "text", "id": "button_1_label", "label": "Gumb 1 – besedilo", "default": "Pokličite mojstra"},
    {"type": "text", "id": "button_1_url", "label": "Gumb 1 – povezava", "default": "tel:+38670644056", "info": "Npr. tel:+38670644056 ali /pages/kontakt"},
    {"type": "text", "id": "button_2_label", "label": "Gumb 2 – besedilo", "default": "Personaliziraj darilo"},
    {"type": "url", "id": "button_2_url", "label": "Gumb 2 – URL"},
    {"type": "header", "content": "Koraki"},
    {"type": "range", "id": "columns", "label": "Največ stolpcev (namizje)", "min": 1, "max": 4, "step": 1, "default": 3},
    {"type": "checkbox", "id": "show_numbers", "label": "Prikaži številke korakov", "default": true},
    {"type": "checkbox", "id": "show_lines", "label": "Prikaži ločilne črte", "default": true},
    {"type": "color", "id": "line_color", "label": "Barva črt"},
    {"type": "color", "id": "num_color", "label": "Barva številk", "info": "Pustite prazno za poudarjeno modro."},
    {"type": "range", "id": "num_size", "label": "Velikost številk (namizje)", "min": 16, "max": 72, "step": 1, "default": 40, "unit": "px"},
    {"type": "range", "id": "num_size_mobile", "label": "Velikost številk (mobilno)", "min": 14, "max": 48, "step": 1, "default": 26, "unit": "px"},
    {"type": "range", "id": "step_title_size", "label": "Velikost naslova koraka (namizje)", "min": 12, "max": 32, "step": 1, "default": 18, "unit": "px"},
    {"type": "range", "id": "step_title_size_mobile", "label": "Velikost naslova koraka (mobilno)", "min": 12, "max": 28, "step": 1, "default": 17, "unit": "px"},
    {"type": "range", "id": "step_text_size", "label": "Velikost besedila koraka (namizje)", "min": 11, "max": 22, "step": 1, "default": 15, "unit": "px"},
    {"type": "range", "id": "step_text_size_mobile", "label": "Velikost besedila koraka (mobilno)", "min": 11, "max": 20, "step": 1, "default": 13, "unit": "px"},
    {"type": "range", "id": "block_gap", "label": "Razmik med deli sekcije", "min": 16, "max": 120, "step": 4, "default": 64, "unit": "px"},
    {"type": "header", "content": "Mobilno"},
    {"type": "checkbox", "id": "show_text_mobile", "label": "Prikaži uvodno besedilo na mobilnem", "default": false},
    {"type": "checkbox", "id": "show_button2_mobile", "label": "Prikaži drugi gumb na mobilnem", "default": false},
    {"type": "header", "content": "Barve"},
    {"type": "color", "id": "s_bg", "label": "Ozadje sekcije", "info": "Pustite prazno za privzeto barvo."},
    {"type": "color", "id": "s_text", "label": "Besedilo"},
    {"type": "color", "id": "s_heading", "label": "Naslovi"},
    {"type": "color", "id": "s_accent", "label": "Poudarek (nadnaslovi, številke)"},
    {"type": "color", "id": "s_btn_bg", "label": "Gumb – ozadje"},
    {"type": "color", "id": "s_btn_fg", "label": "Gumb – besedilo"},
    {"type": "header", "content": "Slika v ozadju"},
    {"type": "image_picker", "id": "s_bg_image", "label": "Slika v ozadju sekcije"},
    {"type": "range", "id": "s_bg_overlay", "label": "Temnost prekrivanja slike", "min": 0, "max": 90, "step": 5, "default": 0, "unit": "%"},
    {"type": "header", "content": "Tipografija"},
    {"type": "select", "id": "s_heading_font", "label": "Pisava naslova", "options": [{"value": "theme", "label": "Privzeto (tema)"}, {"value": "heading", "label": "Pisava naslovov (Nastavitve teme)"}, {"value": "body", "label": "Pisava besedila (Nastavitve teme)"}, {"value": "ui", "label": "Pisava vmesnika (Nastavitve teme)"}, {"value": "logo", "label": "Montserrat"}, {"value": "georgia", "label": "Georgia"}, {"value": "system", "label": "Sistemska pisava"}, {"value": "custom1", "label": "Pisava po meri 1"}, {"value": "custom2", "label": "Pisava po meri 2"}], "default": "theme"},
    {"type": "select", "id": "s_heading_weight", "label": "Debelina naslova", "options": [{"value": "theme", "label": "Privzeto"}, {"value": "300", "label": "Tanka (300)"}, {"value": "400", "label": "Navadna (400)"}, {"value": "500", "label": "Srednja (500)"}, {"value": "600", "label": "Polkrepka (600)"}, {"value": "700", "label": "Krepka (700)"}], "default": "theme"},
    {"type": "range", "id": "s_heading_size", "label": "Velikost naslova (namizje)", "min": 24, "max": 90, "step": 1, "default": 50, "unit": "px"},
    {"type": "range", "id": "s_heading_size_m", "label": "Velikost naslova (mobilno)", "min": 18, "max": 60, "step": 1, "default": 30, "unit": "px"},
    {"type": "range", "id": "s_body_size", "label": "Velikost uvodnega besedila (namizje)", "min": 11, "max": 24, "step": 1, "default": 17, "unit": "px"},
    {"type": "range", "id": "s_body_size_m", "label": "Velikost uvodnega besedila (mobilno)", "min": 11, "max": 24, "step": 1, "default": 15, "unit": "px"},
    {"type": "select", "id": "s_align", "label": "Poravnava besedila", "options": [{"value": "default", "label": "Privzeto"}, {"value": "left", "label": "Levo"}, {"value": "center", "label": "Sredina"}, {"value": "right", "label": "Desno"}], "default": "default"},
    {"type": "header", "content": "Razmik"},
    {"type": "range", "id": "pt", "label": "Razmik zgoraj (namizje)", "min": 0, "max": 200, "step": 4, "default": 160, "unit": "px"},
    {"type": "range", "id": "pb", "label": "Razmik spodaj (namizje)", "min": 0, "max": 200, "step": 4, "default": 0, "unit": "px"},
    {"type": "range", "id": "pt_mobile", "label": "Razmik zgoraj (mobilno)", "min": 0, "max": 120, "step": 4, "default": 72, "unit": "px"},
    {"type": "range", "id": "pb_mobile", "label": "Razmik spodaj (mobilno)", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px"}
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "Korak",
      "settings": [
        {"type": "image_picker", "id": "icon", "label": "Ikona ali ilustracija (neobvezno)"},
        {"type": "text", "id": "title", "label": "Naslov", "default": "Posvet z mojstrom"},
        {"type": "textarea", "id": "text", "label": "Besedilo"}
      ]
    }
  ],
  "presets": [{"name": "Postopek (koraki)", "blocks": [{"type": "step", "settings": {"title": "Posvet z mojstrom", "text": "Pokličite ali nas obiščite. Skupaj izberemo obliko, debelino, zlato in kamne."}}, {"type": "step", "settings": {"title": "Potrditev cene", "text": "Ker cene zlata nihajo, vam končno ceno potrdimo ob naročilu – brez presenečenj."}}, {"type": "step", "settings": {"title": "Ročna izdelava", "text": "Vaš kos nastane v naši delavnici in vas doseže v darilni embalaži."}}]}]
}
{% endschema %}
