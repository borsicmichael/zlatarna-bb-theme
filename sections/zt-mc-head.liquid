<div class="page-width coll" data-collection>
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span>
    <a href="{{ routes.collections_url }}">{{ 'collections.all' | t }}</a><span>/</span>
    <span aria-current="page">{{ collection.title | escape }}</span>
  </nav>

  <div class="coll-head s-align">
    {%- if st.show_eyebrow -%}<p class="eyebrow">{{ shop.name | escape }}</p>{%- endif -%}
    <h1 class="h-display">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank and st.show_description -%}<div class="rte coll-head__desc">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- if st.show_chips -%}
    <div class="chips" role="list">
      <a role="listitem" class="chip{% if collection.handle == 'all' %} is-active{% endif %}" href="{{ routes.all_products_collection_url }}">{{ 'collections.everything' | t }}</a>
      {%- for c in collections -%}
        {%- if c.handle != 'all' and c.all_products_count > 0 -%}
          <a role="listitem" class="chip{% if c.handle == collection.handle %} is-active{% endif %}" href="{{ c.url }}">{{ c.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>
{% schema %}
{"name":"T","settings":[{"type":"range","id":"per_page","label":"P","min":8,"max":48,"step":4,"default":24}]}
{% endschema %}
