<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&family=Manrope:wght@400;500;600&family=Montserrat:wght@500&display=swap" rel="stylesheet">
    {%- style -%}
      :root {
        --c-primary: {{ settings.color_primary | default: '#13293D' }}; --c-accent: {{ settings.color_accent | default: '#89CFF0' }}; --c-accent-dark: {{ settings.color_accent_dark | default: '#006494' }};
        --c-bg: {{ settings.color_background | default: '#F7F9FA' }}; --c-text: {{ settings.color_primary | default: '#13293D' }}; --c-muted: #3F4E5B; --c-subtle: #55636F;
        --c-line: #D5DEE5; --c-line-strong: #C9D4DD; --c-tint: #E4F2FA; --c-placeholder: #E1E8EE;
        --f-serif: 'Playfair Display', Georgia, serif; --f-sans: 'Manrope', system-ui, sans-serif; --f-logo: 'Montserrat', sans-serif;
        --page-width: {{ settings.page_width | default: '1312' }}px; --radius: {{ settings.radius | default: '16' }}px;
      }
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
