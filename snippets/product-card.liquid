{%- comment -%} Grid card. Params: product, hide_price {%- endcomment -%}
<a class="card" href="{{ product.url }}">
  <div class="card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,400,600,800', sizes: '(max-width: 749px) 50vw, 25vw', alt: product.featured_media.alt | default: product.title }}
    {%- else -%}
      {{ 'product-3' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div>
    <h3 class="card__title">{{ product.title | escape }}</h3>
    {%- unless hide_price -%}
    <p class="card__price">
      {%- if product.available == false -%}
        {{ 'products.sold_out' | t }}
      {%- elsif product.price_varies -%}
        {{ 'products.from' | t: price: product.price_min | money }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </p>
    {%- endunless -%}
  </div>
</a>
