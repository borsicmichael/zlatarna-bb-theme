{%- comment -%} Line icons (paths match the Design boards). Params: name, px (default 20), sw (stroke width, default 1.5) {%- endcomment -%}
{%- assign s = px | default: 20 -%}
{%- assign w = sw | default: 1.5 -%}
<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ w }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'cart' -%}<path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'arrow-left' -%}<path d="M20 12H4M10 6l-6 6 6 6"/>
    {%- when 'arrow-right' -%}<path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'arrow-up-right' -%}<path d="M7 17L17 7M9 7h8v8"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'phone' -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
    {%- when 'image' -%}<rect x="2.8" y="4.8" width="18.4" height="14.4" rx=".8"/><circle cx="8.4" cy="10" r="1.8"/><path d="M2.8 16.8l5.6-4.8 4 3.2 3.2-2.4 5.6 4.4"/>
    {%- when 'chain' -%}<ellipse cx="8" cy="12" rx="4.4" ry="2.8"/><ellipse cx="12" cy="12" rx="2.8" ry="4.4"/><ellipse cx="16" cy="12" rx="4.4" ry="2.8"/>
  {%- endcase -%}
</svg>
