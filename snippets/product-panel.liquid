{%- comment -%} Tall image panel used in tabbed carousels. Params: item (product, optional), title (placeholder name), show_price {%- endcomment -%}
{%- if item != blank -%}
  <a class="panel{% if item.featured_media %} panel--image{% endif %}" href="{{ item.url }}">
    {%- if item.featured_media -%}
      {{ item.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,450,600,700', sizes: '(max-width: 749px) 230px, 290px', alt: item.featured_media.alt | default: item.title }}
    {%- else -%}
      <span class="panel__label">Fotografija</span>
    {%- endif -%}
    <span class="panel__arrow">{% render 'icon', name: 'arrow-up-right', px: 16, sw: 1.8 %}</span>
    <span class="panel__name">
      {{ item.title | escape }}
      {%- if show_price -%}
        <span class="panel__price">
          {%- if item.price_varies -%}{{ 'products.from' | t: price: item.price_min | money }}{%- else -%}{{ item.price | money }}{%- endif -%}
        </span>
      {%- endif -%}
    </span>
  </a>
{%- else -%}
  <div class="panel">
    <span class="panel__label">Fotografija</span>
    <span class="panel__arrow">{% render 'icon', name: 'arrow-up-right', px: 16, sw: 1.8 %}</span>
    <span class="panel__name">{{ title | default: '[Ime izdelka]' | escape }}</span>
  </div>
{%- endif -%}
