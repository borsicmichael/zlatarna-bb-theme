<div class="page-width">
  <div class="empty" style="min-height:70vh;justify-content:center">
    <span class="logo">{% render 'logo', height: 64 %}</span>
    <h1 class="h-display">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="rte">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p class="form-message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="newsletter__row" style="margin-top:16px">
        <label class="visually-hidden" for="Password">Geslo</label>
        <input class="field__input" type="password" name="password" id="Password" placeholder="Geslo" autocomplete="current-password">
        <button type="submit" class="btn">Vstop</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Geslo",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Naslov", "default": "Kmalu odpiramo" }
  ]
}
{% endschema %}
