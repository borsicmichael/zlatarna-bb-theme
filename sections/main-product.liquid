{%- comment -%} rev 7 {%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign has_options = true
  if product.has_only_default_variant
    assign has_options = false
  endif
-%}
{% render 'section-style', id: section.id, s: section.settings, h: '.product__title', b: '.product__info' %}
{%- liquid
  assign st = section.settings
  assign sel = '#shopify-section-' | append: section.id
-%}
{%- style -%}
  {{ sel }} .gallery__main { height: {{ st.gallery_height | default: 820 }}px; border-radius: {{ st.image_radius }}px; }
    {{ sel }} .gallery__main img { object-fit: {{ st.image_fit }}; }
  {{ sel }} .product__price { font-size: {{ st.price_size }}px; {% if st.price_color != blank %}color: {{ st.price_color }};{% endif %} }
  {%- if st.pill_bg != blank %}{{ sel }} .pill input:checked + span { background: {{ st.pill_bg }}; border-color: {{ st.pill_bg }}; }{% endif %}
  {%- if st.pill_fg != blank %}{{ sel }} .pill input:checked + span { color: {{ st.pill_fg }}; }{% endif %}
  {%- if st.badge_bg != blank %}{{ sel }} .badge:not(.badge--outline) { background: {{ st.badge_bg }}; }{% endif %}
  {%- unless st.sticky_info %}{{ sel }} .product__info { position: static; }{% endunless %}
  {%- if st.layout == 'equal' %}{{ sel }} .gallery { grid-column: span 6; } {{ sel }} .product__info { grid-column: span 6; }{% endif %}
  {%- if st.layout == 'right' %}{{ sel }} .gallery { order: 2; } {{ sel }} .product__info { padding: 8px 32px 0 0; }{% endif %}
  {%- unless st.show_breadcrumbs %}{{ sel }} .breadcrumbs { display: none; }{% endunless %}
  {%- unless st.show_details %}{{ sel }} .product-details { display: none; }{% endunless %}
  {{ sel }} .product__sku { margin: 10px 0 0; font-family: var(--f-sans); font-size: 13px; letter-spacing: .04em; color: var(--c-muted); }
  {{ sel }} .product__sku span { color: var(--c-text); font-weight: 600; }
  @media (max-width: 1100px) { {{ sel }} .gallery__main { height: auto; aspect-ratio: 4 / 5; } }
  @media (max-width: 749px) {
    {{ sel }} .product__info { padding: 0; }
  }
{%- endstyle -%}
<div class="page-width" data-product data-money-format="{{ shop.money_format | escape }}">
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    {%- if collection -%}<span>/</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a>{%- endif -%}
    <span>/</span><span aria-current="page">{{ product.title | escape }}</span>
  </nav>

  <div class="product">
    <div class="gallery">
      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="gallery__thumb" data-thumb="{{ media.id }}" aria-current="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-label="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="gallery__main">
        {%- for media in product.media -%}
          <div class="gallery__slide{% if media.id == product.featured_media.id %} is-active{% endif %}" data-slide="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600', sizes: '(max-width: 749px) 100vw, 55vw' }}
                {%- else -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(max-width: 749px) 100vw, 55vw' }}
                {%- endif -%}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="gallery__slide is-active"><span class="gallery__ph">{% render 'icon', name: 'chain', px: '100%', sw: 0.24 %}</span></div>
        {%- endfor -%}
      </div>
    </div>

    <div class="product__info">
      <div class="product__head">
      {%- assign show_badges = false -%}
      {%- if product.handle == 'kraljeva-verizica-3-mm-8-mm-izdelava-po-narocilu' or product.tags contains 'po-narocilu' -%}{%- assign show_badges = true -%}{%- endif -%}
      {%- if show_badges and section.settings.badge_1 != blank or show_badges and section.settings.badge_2 != blank -%}
        <div class="badges">
          {%- if section.settings.badge_1 != blank -%}<span class="badge">{{ section.settings.badge_1 | escape }}</span>{%- endif -%}
          {%- if section.settings.badge_2 != blank -%}<span class="badge badge--outline">{{ section.settings.badge_2 | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}

        <h1 class="product__title">{{ product.title | escape }}</h1>
        <p class="product__sku"{% if current_variant.sku == blank %} hidden{% endif %}>Šifra izdelka: <span data-sku>{{ current_variant.sku | escape }}</span></p>
        {%- assign subtitle = product.metafields.custom.subtitle.value -%}
        {%- if subtitle != blank -%}<p class="product__subtitle">{{ subtitle }}</p>{%- endif -%}
      </div>

      <div class="product__price-box">
        <span class="product__price" data-price>
          {%- liquid
            assign min_price = 0
            assign max_price = 0
            for variant in product.variants
              if variant.price > 0
                if min_price == 0 or variant.price < min_price
                  assign min_price = variant.price
                endif
                if variant.price > max_price
                  assign max_price = variant.price
                endif
              endif
            endfor
          -%}
          {%- if current_variant.price > 0 -%}
            {{ current_variant.price | money }}
          {%- elsif min_price == 0 -%}
            Cena po povpraševanju
          {%- elsif min_price != max_price -%}
            Od {{ min_price | money }}
          {%- else -%}
            {{ min_price | money }}
          {%- endif -%}
        </span>
        <span class="product__price-note">
          {%- if has_options -%}{% if section.settings.selected_prefix != blank %}{{ section.settings.selected_prefix }} {{ product.options_with_values.first.name | downcase | escape }}{% else %}{{ product.options_with_values.first.name | escape }}{% endif %}: <strong data-selected>{{ current_variant.title | escape }}</strong>{% if section.settings.price_note != blank %} · {% endif %}{%- endif -%}
          {{- section.settings.price_note -}}
        </span>
      </div>

      {%- if section.settings.show_excerpt and product.description != blank -%}
        <div class="product__excerpt">
          <p>{{ product.description | replace: '</li>', ' · ' | replace: '</p>', ' ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | strip_html | strip_newlines | replace: '&nbsp;', ' ' | truncatewords: 26, '…' }}</p>
          <a href="#Opis-{{ section.id }}" class="product__more">{{ section.settings.excerpt_link | escape }}</a>
        </div>
      {%- endif -%}

      {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <div style="display:flex;flex-direction:column;gap:28px">
          {%- if has_options -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="option" data-option>
                <legend class="field__label">{{ option.name | escape }}</legend>
                <div class="pills">
                  {%- for value in option.values -%}
                    <label class="pill">
                      <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endif -%}

          {%- if section.settings.show_length -%}
            <div class="field">
              <label class="field__label" for="Length-{{ section.id }}">{{ 'products.length' | t }}</label>
              <input class="field__input" id="Length-{{ section.id }}" type="number" min="10" max="120" step="0.5" inputmode="decimal" name="properties[{{ 'products.length' | t }}]" placeholder="{{ 'products.length_placeholder' | t }}">
            </div>
          {%- endif -%}

          {%- if section.settings.show_note -%}
            <div class="field">
              <label class="field__label" for="Note-{{ section.id }}">{{ 'products.note' | t }}</label>
              <textarea class="field__input" id="Note-{{ section.id }}" name="properties[{{ 'products.note' | t }}]"></textarea>
            </div>
          {%- endif -%}

          <div class="product__buy">
            <div class="qty" data-qty>
              <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.quantity_decrease' | t }}">{% render 'icon', name: 'minus', px: 16 %}</button>
              <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
              <input class="qty__input" id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.quantity_increase' | t }}">{% render 'icon', name: 'plus', px: 16 %}</button>
            </div>
            {%- assign soldout_label = 'products.sold_out' | t -%}
            <button type="submit" name="add" class="btn btn--sans product__add" data-label="{{ section.settings.button_label | escape }}" data-soldout="{{ soldout_label | escape }}"{% if current_variant.available == false or current_variant.price == 0 %} disabled{% endif %}>
              {% render 'icon', name: 'cart', px: 18 %}
              <span data-add-label>{%- if current_variant.available -%}{{ section.settings.button_label | escape }}{%- else -%}{{ soldout_label }}{%- endif -%}</span>
            </button>
          </div>
          {%- if section.settings.show_buy_now -%}
            <div class="product__checkout">{{ form | payment_button }}</div>
          {%- endif -%}
          <div class="product__buttons">
            {%- if section.settings.phone_label != blank -%}
              <a class="btn btn--outline btn--sans btn--block" href="tel:{{ section.settings.phone | remove: ' ' }}">{% render 'icon', name: 'phone', px: 16 %}{{ section.settings.phone_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endform -%}

      <script type="application/json" data-variants>{{ product.variants | json }}</script>

      {%- if section.blocks.size > 0 -%}
        <div class="trust">
          {%- for block in section.blocks -%}
            <div class="trust__row" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
              {%- elsif block.settings.default_icon != 'none' -%}
                {%- case block.settings.default_icon -%}
                  {%- when 'dostava' -%}{%- assign ic = 'truck' -%}
                  {%- when 'personaliziran' -%}{%- assign ic = 'pen' -%}
                  {%- when 'posvet' -%}{%- assign ic = 'phone' -%}
                  {%- when 'rocna' -%}{%- assign ic = 'hand' -%}
                  {%- else -%}{%- assign ic = 'shield' -%}
                {%- endcase -%}
                <span class="trust__icon">{% render 'icon', name: ic, px: 22 %}</span>
              {%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="pdp-more product-details" id="Opis-{{ section.id }}">
    <div class="pdp-more__desc">
      <p class="pdp-more__eyebrow">{{ section.settings.details_1_title | escape }}</p>
      <h2 class="pdp-more__title">{{ product.title | escape }}</h2>
      {%- liquid
        assign desc_parts = product.description | split: '<img'
        capture clean_desc
          echo desc_parts[0]
          for part in desc_parts offset: 1
            if part contains 'logo-zlatarna' or part contains 'zlatarna-bb.si/wp-content'
              assign img_tag = part | split: '>' | first
              echo part | remove_first: img_tag | remove_first: '>'
            else
              echo '<img' | append: part
            endif
          endfor
        endcapture
      -%}
      <div class="rte pdp-more__rte">{{ clean_desc }}</div>
    </div>
    <aside class="pdp-more__side">
      <div class="acc-list">
        {%- if section.settings.details_2_title != blank -%}
          <details class="acc" open>
            <summary>{{ section.settings.details_2_title | escape }}{% render 'icon', name: 'plus', px: 16 %}</summary>
            <div class="rte acc__body">{{ section.settings.details_2_text }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.details_3_title != blank -%}
          <details class="acc">
            <summary>{{ section.settings.details_3_title | escape }}{% render 'icon', name: 'plus', px: 16 %}</summary>
            <div class="rte acc__body">{{ section.settings.details_3_text }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.details_4_title != blank and section.settings.details_4_text != blank -%}
          <details class="acc">
            <summary>{{ section.settings.details_4_title | escape }}{% render 'icon', name: 'plus', px: 16 %}</summary>
            <div class="rte acc__body">{{ section.settings.details_4_text }}</div>
          </details>
        {%- endif -%}
      </div>
      {%- if section.settings.help_title != blank -%}
        <div class="pdp-help">
          <p class="pdp-help__title">{{ section.settings.help_title | escape }}</p>
          {%- if section.settings.help_text != blank -%}<p class="pdp-help__text">{{ section.settings.help_text | escape }}</p>{%- endif -%}
          {%- if section.settings.phone != blank -%}
            <a class="btn btn--sans btn--block" href="tel:{{ section.settings.phone | remove: ' ' }}">{% render 'icon', name: 'phone', px: 16 %}{{ section.settings.phone | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Izdelek",
  "class": "section-main-product",
  "settings": [
    {"type": "text", "id": "badge_1", "label": "Značka 1", "default": "Izdelava po naročilu"},
    {"type": "text", "id": "badge_2", "label": "Značka 2", "default": "Ročno delo"},
    {"type": "text", "id": "price_note", "label": "Opomba pod ceno", "default": "končno ceno potrdimo ob naročilu"},
    {"type": "text", "id": "button_label", "label": "Gumb – besedilo", "default": "Dodaj v košarico"},
    {"type": "checkbox", "id": "show_length", "label": "Polje »Želena dolžina (cm)«", "default": false},
    {"type": "checkbox", "id": "show_buy_now", "label": "Gumb »Kupi zdaj« (hitri nakup)", "default": true},
    {"type": "checkbox", "id": "show_note", "label": "Polje za opombo / gravuro", "default": false},
    {"type": "text", "id": "phone_label", "label": "Gumb za klic – besedilo", "default": "Posvet z mojstrom · 070 644 056"},
    {"type": "text", "id": "phone", "label": "Telefon", "default": "+386 70 644 056"},
    {"type": "checkbox", "id": "show_excerpt", "label": "Kratek povzetek opisa ob ceni", "default": true},
    {"type": "text", "id": "excerpt_link", "label": "Povezava na opis – besedilo", "default": "Preberi celoten opis"},
    {"type": "header", "content": "Opis in informacije pod izdelkom"},
    {"type": "text", "id": "details_1_title", "label": "Nadnaslov opisa (vsebina = opis izdelka)", "default": "O izdelku"},
    {"type": "text", "id": "details_2_title", "label": "Stolpec 2 – naslov", "default": "Dostava in darilo"},
    {"type": "richtext", "id": "details_2_text", "label": "Stolpec 2 – besedilo", "default": "<p>Pošiljke so sledljive, nakit prejmete v darilni embalaži. Pri nakupu nad 100 € je dostava brezplačna.</p>"},
    {"type": "text", "id": "details_3_title", "label": "Stolpec 3 – naslov", "default": "Zakaj cena niha?"},
    {"type": "richtext", "id": "details_3_text", "label": "Stolpec 3 – besedilo", "default": "<p>Cena je vezana na trenutno ceno zlata. Če se cena ob naročilu spremeni, vas pred izdelavo pokličemo in jo potrdimo z vami.</p>"},
    {"type": "text", "id": "details_4_title", "label": "Razdelek 4 – naslov", "default": "Nega nakita"},
    {"type": "richtext", "id": "details_4_text", "label": "Razdelek 4 – besedilo", "default": "<p>Nakit hranite ločeno v mehki vrečki, ga ne izpostavljajte kemikalijam in ga občasno očistite z mehko krpo. Za profesionalno čiščenje nas obiščite v delavnici.</p>"},
    {"type": "text", "id": "help_title", "label": "Kartica za pomoč – naslov", "default": "Imate vprašanje?"},
    {"type": "text", "id": "help_text", "label": "Kartica za pomoč – besedilo", "default": "Pokličite nas – zlatarski mojster vam z veseljem svetuje glede izbire, velikosti ali izdelave po meri."},
    {"type": "header", "content": "Postavitev"},
    {"type": "select", "id": "layout", "label": "Postavitev", "options": [{"value": "default", "label": "Galerija levo (7/5)"}, {"value": "equal", "label": "Galerija levo (polovica/polovica)"}, {"value": "right", "label": "Galerija desno"}], "default": "default"},
    {"type": "checkbox", "id": "sticky_info", "label": "Podatki ostanejo vidni ob pomikanju", "default": true},
    {"type": "checkbox", "id": "show_breadcrumbs", "label": "Prikaži drobtinice", "default": true},
    {"type": "checkbox", "id": "show_details", "label": "Prikaži opis in informacije pod izdelkom", "default": true},
    {"type": "header", "content": "Galerija"},
    {"type": "number", "id": "gallery_height", "label": "Višina glavne slike v px (namizje)", "default": 820},
    {"type": "select", "id": "image_fit", "label": "Prikaz slike", "options": [{"value": "cover", "label": "Zapolni okvir"}, {"value": "contain", "label": "Prikaži celo sliko"}], "default": "cover"},
    {"type": "range", "id": "image_radius", "label": "Zaobljenost glavne slike", "min": 0, "max": 40, "step": 2, "default": 16, "unit": "px"},
    {"type": "header", "content": "Cena, možnosti in značke"},
    {"type": "range", "id": "price_size", "label": "Velikost cene (namizje)", "min": 16, "max": 48, "step": 1, "default": 29, "unit": "px"},
    {"type": "color", "id": "pill_bg", "label": "Izbrana možnost – ozadje", "info": "Pustite prazno za svetlo modro."},
    {"type": "header", "content": "Barve"},
    {"type": "color", "id": "s_bg", "label": "Ozadje sekcije", "info": "Pustite prazno za privzeto barvo."},
    {"type": "color", "id": "s_heading", "label": "Naslovi"},
    {"type": "color", "id": "s_btn_bg", "label": "Gumb – ozadje"},
    {"type": "color", "id": "s_btn_fg", "label": "Gumb – besedilo"},
    {"type": "header", "content": "Tipografija"},
    {"type": "select", "id": "s_heading_font", "label": "Pisava naslova", "options": [{"value": "theme", "label": "Privzeto (tema)"}, {"value": "heading", "label": "Pisava naslovov (Nastavitve teme)"}, {"value": "body", "label": "Pisava besedila (Nastavitve teme)"}, {"value": "ui", "label": "Pisava vmesnika (Nastavitve teme)"}, {"value": "logo", "label": "Montserrat"}, {"value": "georgia", "label": "Georgia"}, {"value": "system", "label": "Sistemska pisava"}, {"value": "custom1", "label": "Pisava po meri 1"}, {"value": "custom2", "label": "Pisava po meri 2"}], "default": "theme"},
    {"type": "range", "id": "s_heading_size", "label": "Velikost imena izdelka (namizje)", "min": 24, "max": 90, "step": 1, "default": 52, "unit": "px"},
    {"type": "range", "id": "s_heading_size_m", "label": "Velikost imena izdelka (mobilno)", "min": 20, "max": 60, "step": 1, "default": 36, "unit": "px"},
    {"type": "header", "content": "Razmik"},
    {"type": "range", "id": "pt", "label": "Razmik zgoraj (namizje)", "min": 0, "max": 200, "step": 4, "default": 0, "unit": "px"},
    {"type": "range", "id": "pb", "label": "Razmik spodaj (namizje)", "min": 0, "max": 200, "step": 4, "default": 0, "unit": "px"},
    {"type": "range", "id": "pt_mobile", "label": "Razmik zgoraj (mobilno)", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px"},
    {"type": "range", "id": "pb_mobile", "label": "Razmik spodaj (mobilno)", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px"}
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Zaupanje (vrstica)",
      "limit": 5,
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Ilustracija"},
        {"type": "select", "id": "default_icon", "label": "Privzeta ilustracija", "default": "dostava", "options": [{"value": "personaliziran", "label": "Personaliziran nakit"}, {"value": "dostava", "label": "Dostava"}, {"value": "posvet", "label": "Posvet"}, {"value": "rocna", "label": "Ročna izdelava"}, {"value": "none", "label": "Brez"}]},
        {"type": "text", "id": "text", "label": "Besedilo", "default": "Brezplačna dostava nad 100 € · sledljiva pošiljka"}
      ]
    }
  ]
}
{% endschema %}
