{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign has_options = true
  if product.has_only_default_variant
    assign has_options = false
  endif
-%}
<div class="page-width" data-product data-money-format="{{ shop.money_format | escape }}">
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    {%- if collection -%}<span>/</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a>{%- endif -%}
    <span>/</span><span aria-current="page">{{ product.title | escape }}</span>
  </nav>

  <div class="product">
    <div class="gallery">
      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="gallery__thumb" data-thumb="{{ media.id }}" aria-current="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" aria-label="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="gallery__main">
        {%- for media in product.media -%}
          <div class="gallery__slide{% if media.id == product.featured_media.id %} is-active{% endif %}" data-slide="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600', sizes: '(max-width: 749px) 100vw, 55vw' }}
                {%- else -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(max-width: 749px) 100vw, 55vw' }}
                {%- endif -%}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="gallery__slide is-active"><span class="gallery__ph">{% render 'icon', name: 'chain', px: '100%', sw: 0.24 %}</span></div>
        {%- endfor -%}
      </div>
    </div>

    <div class="product__info">
      <div class="product__head">
      {%- if section.settings.badge_1 != blank or section.settings.badge_2 != blank -%}
        <div class="badges">
          {%- if section.settings.badge_1 != blank -%}<span class="badge">{{ section.settings.badge_1 | escape }}</span>{%- endif -%}
          {%- if section.settings.badge_2 != blank -%}<span class="badge badge--outline">{{ section.settings.badge_2 | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}

        <h1 class="product__title">{{ product.title | escape }}</h1>
        {%- assign subtitle = product.metafields.custom.subtitle.value -%}
        {%- if subtitle != blank -%}<p class="product__subtitle">{{ subtitle }}</p>{%- endif -%}
      </div>

      <div class="product__price-box">
        <span class="product__price" data-price>
          {%- if product.price_varies -%}
            {{ product.price_min | money }} – {{ product.price_max | money }}
          {%- else -%}
            {{ current_variant.price | money }}
          {%- endif -%}
        </span>
        <span class="product__price-note">
          {%- if has_options -%}{{ section.settings.selected_prefix }} {{ product.options_with_values.first.name | downcase | escape }}: <strong data-selected>{{ current_variant.title | escape }}</strong>{% if section.settings.price_note != blank %} · {% endif %}{%- endif -%}
          {{- section.settings.price_note -}}
        </span>
      </div>

      {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <div style="display:flex;flex-direction:column;gap:28px">
          {%- if has_options -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="option" data-option>
                <legend class="field__label">{{ option.name | escape }}</legend>
                <div class="pills">
                  {%- for value in option.values -%}
                    <label class="pill">
                      <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endif -%}

          {%- if section.settings.show_length -%}
            <div class="field">
              <label class="field__label" for="Length-{{ section.id }}">{{ 'products.length' | t }}</label>
              <input class="field__input" id="Length-{{ section.id }}" type="number" min="10" max="120" step="0.5" inputmode="decimal" name="properties[{{ 'products.length' | t }}]" placeholder="{{ 'products.length_placeholder' | t }}"{% if section.settings.length_required %} required{% endif %}>
            </div>
          {%- endif -%}

          {%- if section.settings.show_note -%}
            <div class="field">
              <label class="field__label" for="Note-{{ section.id }}">{{ 'products.note' | t }}</label>
              <textarea class="field__input" id="Note-{{ section.id }}" name="properties[{{ 'products.note' | t }}]"></textarea>
            </div>
          {%- endif -%}

          <div class="product__buttons">
            {%- assign soldout_label = 'products.sold_out' | t -%}
            <button type="submit" name="add" class="btn btn--light btn--sans btn--block" data-label="{{ section.settings.button_label | escape }}" data-soldout="{{ soldout_label | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
              {%- if current_variant.available -%}{{ section.settings.button_label | escape }}{%- else -%}{{ soldout_label }}{%- endif -%}
            </button>
            {%- if section.settings.phone_label != blank -%}
              <a class="btn btn--outline btn--sans btn--block" href="tel:{{ section.settings.phone | remove: ' ' }}">{% render 'icon', name: 'phone', px: 16 %}{{ section.settings.phone_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endform -%}

      <script type="application/json" data-variants>{{ product.variants | json }}</script>

      {%- if section.blocks.size > 0 -%}
        <div class="trust">
          {%- for block in section.blocks -%}
            <div class="trust__row" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
              {%- elsif block.settings.default_icon != 'none' -%}
                {%- assign icon_file = 'icon-' | append: block.settings.default_icon | append: '.png' -%}
                <img src="{{ icon_file | asset_url }}" alt="" width="52" height="52" loading="lazy">
              {%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="product-details">
    <div>
      <h3>{{ section.settings.details_1_title | escape }}</h3>
      <div class="rte">{{ product.description }}</div>
    </div>
    <div>
      <h3>{{ section.settings.details_2_title | escape }}</h3>
      <div class="rte">{{ section.settings.details_2_text }}</div>
    </div>
    <div>
      <h3>{{ section.settings.details_3_title | escape }}</h3>
      <div class="rte">{{ section.settings.details_3_text }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Izdelek",
  "class": "section-main-product",
  "settings": [
    { "type": "text", "id": "badge_1", "label": "Značka 1", "default": "Izdelava po naročilu" },
    { "type": "text", "id": "badge_2", "label": "Značka 2", "default": "Ročno delo" },
    { "type": "text", "id": "selected_prefix", "label": "Predpona izbrane možnosti", "default": "Izbrana" },
    { "type": "text", "id": "price_note", "label": "Opomba pod ceno", "default": "končno ceno potrdimo ob naročilu" },
    { "type": "text", "id": "button_label", "label": "Gumb – besedilo", "default": "Oddaj povpraševanje" },
    { "type": "checkbox", "id": "show_length", "label": "Polje »Želena dolžina (cm)«", "default": true },
    { "type": "checkbox", "id": "length_required", "label": "Dolžina je obvezna", "default": false },
    { "type": "checkbox", "id": "show_note", "label": "Polje za opombo / gravuro", "default": false },
    { "type": "text", "id": "phone_label", "label": "Gumb za klic – besedilo", "default": "Posvet z mojstrom · 070 644 056" },
    { "type": "text", "id": "phone", "label": "Telefon", "default": "+386 70 644 056" },
    { "type": "header", "content": "Spodnji stolpci" },
    { "type": "text", "id": "details_1_title", "label": "Stolpec 1 – naslov (vsebina = opis izdelka)", "default": "O izdelku" },
    { "type": "text", "id": "details_2_title", "label": "Stolpec 2 – naslov", "default": "Kako poteka naročilo" },
    { "type": "richtext", "id": "details_2_text", "label": "Stolpec 2 – besedilo", "default": "<p>Oddajte povpraševanje ali nas pokličite. Potrdimo debelino, dolžino in končno ceno, nato verižico ročno izdelamo.</p>" },
    { "type": "text", "id": "details_3_title", "label": "Stolpec 3 – naslov", "default": "Zakaj cena niha?" },
    { "type": "richtext", "id": "details_3_text", "label": "Stolpec 3 – besedilo", "default": "<p>Cena je vezana na trenutno ceno zlata. Zato jo potrdimo ob naročilu – tako plačate pošteno ceno dneva.</p>" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Zaupanje (vrstica)",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Ilustracija" },
        { "type": "select", "id": "default_icon", "label": "Privzeta ilustracija", "default": "dostava", "options": [
          { "value": "personaliziran", "label": "Personaliziran nakit" },
          { "value": "dostava", "label": "Dostava" },
          { "value": "posvet", "label": "Posvet" },
          { "value": "rocna", "label": "Ročna izdelava" },
          { "value": "none", "label": "Brez" }
        ] },
        { "type": "text", "id": "text", "label": "Besedilo", "default": "Brezplačna dostava nad 100 € · sledljiva pošiljka" }
      ]
    }
  ]
}
{% endschema %}
