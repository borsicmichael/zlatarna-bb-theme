<div class="page-width">
  <div class="coll-head"><h1 class="h-display">{{ blog.title | escape }}</h1></div>
  {%- paginate blog.articles by 12 -%}
    <div class="product-grid" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          <div class="card__media" style="aspect-ratio:4/3">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width: 749px) 100vw, 33vw' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <p class="eyebrow">{{ article.published_at | date: '%d. %m. %Y' }}</p>
          <h2 class="card__title">{{ article.title | escape }}</h2>
          <p class="card__price">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="current">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
