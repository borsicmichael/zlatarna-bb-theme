{%- render 'section-style', id: section.id, s: section.settings, h: '.coll-head h1', b: '.cart-table' -%}
<div class="page-width cartpage">
  <div class="coll-head"><h1 class="h-display">{{ 'cart.title' | t }}</h1></div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cartpage__grid" data-cart-form>
      <div class="cartpage__items">
        <div class="cartpage__head" aria-hidden="true">
          <span>{{ 'cart.product' | t }}</span><span>{{ 'cart.quantity' | t }}</span><span>{{ 'cart.total' | t }}</span>
        </div>
        {%- for item in cart.items -%}
          <div class="citem">
            <a class="citem__img" href="{{ item.url }}">
              {%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}
            </a>
            <div class="citem__info">
              <a href="{{ item.url }}" class="citem__title">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<span class="citem__meta">{{ item.variant.title | escape }}</span>{%- endunless -%}
              {%- for p in item.properties -%}
                {%- assign first_char = p.first | slice: 0 -%}
                {%- if p.last != blank and first_char != '_' -%}<span class="citem__meta">{{ p.first | escape }}: {{ p.last | escape }}</span>{%- endif -%}
              {%- endfor -%}
              <span class="citem__meta">{{ item.final_price | money }}</span>
            </div>
            <div class="citem__qty">
              <div class="qty qty--sm" data-qty>
                <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.quantity_decrease' | t }}">{% render 'icon', name: 'minus', px: 14 %}</button>
                <label class="visually-hidden" for="Qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                <input class="qty__input" id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-cart-qty>
                <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.quantity_increase' | t }}">{% render 'icon', name: 'plus', px: 14 %}</button>
              </div>
              <a class="citem__remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.remove' | t }}: {{ item.product.title | escape }}">{% render 'icon', name: 'trash', px: 16 %}<span>{{ 'cart.remove' | t }}</span></a>
            </div>
            <div class="citem__total">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <aside class="cart-summary">
        <div class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
        <p class="note">{{ 'cart.taxes' | t }}</p>
        {%- if section.settings.show_note -%}
          <div class="field">
            <label class="field__label" for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea class="field__input" id="CartNote" name="note">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
        <button type="submit" name="checkout" class="btn btn--sans btn--block">{{ 'cart.checkout' | t }}</button>
        {%- if section.settings.show_update -%}<button type="submit" name="update" class="btn btn--outline btn--sans btn--block" data-cart-update>{{ 'cart.update' | t }}</button>{%- endif -%}
        {%- if additional_checkout_buttons -%}<div class="cart-summary__extra">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        <a class="link-underline cart-summary__continue" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </aside>
    </form>
  {%- else -%}
    <div class="empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Košarica",
  "class": "section-main-cart",
  "settings": [
    {"type": "checkbox", "id": "show_note", "label": "Prikaži polje za opombo", "default": true},
    {"type": "checkbox", "id": "show_update", "label": "Prikaži gumb »Posodobi«", "default": true},
    {"type": "header", "content": "Barve"},
    {"type": "color", "id": "s_bg", "label": "Ozadje sekcije", "info": "Pustite prazno za privzeto barvo."},
    {"type": "color", "id": "s_text", "label": "Besedilo"},
    {"type": "color", "id": "s_heading", "label": "Naslovi"},
    {"type": "color", "id": "s_accent", "label": "Poudarek (nadnaslovi, številke)"},
    {"type": "color", "id": "s_btn_bg", "label": "Gumb – ozadje"},
    {"type": "color", "id": "s_btn_fg", "label": "Gumb – besedilo"},
    {"type": "color", "id": "s_btn2_bg", "label": "Svetel gumb – ozadje"},
    {"type": "color", "id": "s_btn2_fg", "label": "Svetel gumb – besedilo"},
    {"type": "header", "content": "Tipografija"},
    {"type": "select", "id": "s_heading_font", "label": "Pisava naslova", "options": [{"value": "theme", "label": "Privzeto (tema)"}, {"value": "heading", "label": "Pisava naslovov (Nastavitve teme)"}, {"value": "body", "label": "Pisava besedila (Nastavitve teme)"}, {"value": "ui", "label": "Pisava vmesnika (Nastavitve teme)"}, {"value": "logo", "label": "Montserrat"}, {"value": "georgia", "label": "Georgia"}, {"value": "system", "label": "Sistemska pisava"}, {"value": "custom1", "label": "Pisava po meri 1"}, {"value": "custom2", "label": "Pisava po meri 2"}], "default": "theme"},
    {"type": "select", "id": "s_heading_weight", "label": "Debelina naslova", "options": [{"value": "theme", "label": "Privzeto"}, {"value": "300", "label": "Tanka (300)"}, {"value": "400", "label": "Navadna (400)"}, {"value": "500", "label": "Srednja (500)"}, {"value": "600", "label": "Polkrepka (600)"}, {"value": "700", "label": "Krepka (700)"}], "default": "theme"},
    {"type": "select", "id": "s_heading_case", "label": "Velike/male črke naslova", "options": [{"value": "theme", "label": "Privzeto"}, {"value": "none", "label": "Kot je vpisano"}, {"value": "upper", "label": "VELIKE ČRKE"}], "default": "theme"},
    {"type": "range", "id": "s_heading_size", "label": "Velikost naslova (namizje)", "min": 24, "max": 90, "step": 1, "default": 50, "unit": "px"},
    {"type": "range", "id": "s_heading_size_m", "label": "Velikost naslova (mobilno)", "min": 18, "max": 60, "step": 1, "default": 32, "unit": "px"},
    {"type": "select", "id": "s_body_font", "label": "Pisava besedila", "options": [{"value": "theme", "label": "Privzeto (tema)"}, {"value": "heading", "label": "Pisava naslovov (Nastavitve teme)"}, {"value": "body", "label": "Pisava besedila (Nastavitve teme)"}, {"value": "ui", "label": "Pisava vmesnika (Nastavitve teme)"}, {"value": "logo", "label": "Montserrat"}, {"value": "georgia", "label": "Georgia"}, {"value": "system", "label": "Sistemska pisava"}, {"value": "custom1", "label": "Pisava po meri 1"}, {"value": "custom2", "label": "Pisava po meri 2"}], "default": "theme"},
    {"type": "range", "id": "s_body_size", "label": "Velikost besedila (namizje)", "min": 12, "max": 20, "step": 1, "default": 15, "unit": "px"},
    {"type": "range", "id": "s_body_size_m", "label": "Velikost besedila (mobilno)", "min": 12, "max": 20, "step": 1, "default": 15, "unit": "px"},
    {"type": "header", "content": "Razmik"},
    {"type": "range", "id": "pt", "label": "Razmik zgoraj (namizje)", "min": 0, "max": 200, "step": 4, "default": 0, "unit": "px"},
    {"type": "range", "id": "pb", "label": "Razmik spodaj (namizje)", "min": 0, "max": 200, "step": 4, "default": 0, "unit": "px"},
    {"type": "range", "id": "pt_mobile", "label": "Razmik zgoraj (mobilno)", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px"},
    {"type": "range", "id": "pb_mobile", "label": "Razmik spodaj (mobilno)", "min": 0, "max": 120, "step": 4, "default": 0, "unit": "px"}
  ]
}
{% endschema %}
