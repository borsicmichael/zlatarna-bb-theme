{%- comment -%} Global CSS variables + font loading from Theme settings. Rendered in <head> by both layouts. {%- endcomment -%}
{%- liquid
  assign c1 = settings.custom_font_1 | strip
  assign c2 = settings.custom_font_2 | strip
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
{%- if c1 != blank -%}
  <link href="https://fonts.googleapis.com/css2?family={{ c1 | replace: ' ', '+' | url_escape }}&display=swap" rel="stylesheet">
{%- endif -%}
{%- if c2 != blank -%}
  <link href="https://fonts.googleapis.com/css2?family={{ c2 | replace: ' ', '+' | url_escape }}&display=swap" rel="stylesheet">
{%- endif -%}
{%- capture stack_playfair -%}'Playfair Display', Georgia, serif{%- endcapture -%}
{%- capture stack_manrope -%}'Manrope', system-ui, sans-serif{%- endcapture -%}
{%- capture stack_montserrat -%}'Montserrat', system-ui, sans-serif{%- endcapture -%}
{%- capture stack_georgia -%}Georgia, 'Times New Roman', serif{%- endcapture -%}
{%- capture stack_system -%}system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif{%- endcapture -%}
{%- capture stack_custom1 -%}'{{ c1 | default: 'Playfair Display' }}', Georgia, serif{%- endcapture -%}
{%- capture stack_custom2 -%}'{{ c2 | default: 'Manrope' }}', system-ui, sans-serif{%- endcapture -%}
{%- liquid
  case settings.font_heading
    when 'manrope'
      assign f_heading = stack_manrope
    when 'montserrat'
      assign f_heading = stack_montserrat
    when 'georgia'
      assign f_heading = stack_georgia
    when 'system'
      assign f_heading = stack_system
    when 'custom1'
      assign f_heading = stack_custom1
    when 'custom2'
      assign f_heading = stack_custom2
    else
      assign f_heading = stack_playfair
  endcase
  case settings.font_body
    when 'manrope'
      assign f_body = stack_manrope
    when 'montserrat'
      assign f_body = stack_montserrat
    when 'georgia'
      assign f_body = stack_georgia
    when 'system'
      assign f_body = stack_system
    when 'custom1'
      assign f_body = stack_custom1
    when 'custom2'
      assign f_body = stack_custom2
    else
      assign f_body = stack_playfair
  endcase
  case settings.font_ui
    when 'playfair'
      assign f_ui = stack_playfair
    when 'montserrat'
      assign f_ui = stack_montserrat
    when 'georgia'
      assign f_ui = stack_georgia
    when 'system'
      assign f_ui = stack_system
    when 'custom1'
      assign f_ui = stack_custom1
    when 'custom2'
      assign f_ui = stack_custom2
    else
      assign f_ui = stack_manrope
  endcase
  case settings.button_shape
    when 'rounded'
      assign btn_r = '10px'
    when 'square'
      assign btn_r = '0px'
    else
      assign btn_r = '999px'
  endcase
  case settings.input_shape
    when 'rounded'
      assign in_r = '10px'
    when 'square'
      assign in_r = '0px'
    else
      assign in_r = '999px'
  endcase
-%}
{%- style -%}
  :root {
    --c-primary: {{ settings.color_primary | default: '#13293D' }};
    --c-accent: {{ settings.color_accent | default: '#89CFF0' }};
    --c-accent-dark: {{ settings.color_accent_dark | default: '#006494' }};
    --c-bg: {{ settings.color_background | default: '#F7F9FA' }};
    --c-surface: #FFFFFF;
    --c-text: {{ settings.color_text | default: settings.color_primary | default: '#13293D' }};
    --c-muted: {{ settings.color_muted | default: '#3F4E5B' }};
    --c-subtle: #55636F;
    --c-line: {{ settings.color_lines | default: '#D5DEE5' }};
    --c-line-strong: #C9D4DD;
    --c-tint: {{ settings.color_tint | default: '#E4F2FA' }};
    --c-placeholder: #E1E8EE;
    --f-heading: {{ f_heading }};
    --f-heading-weight: {{ settings.font_heading_weight | default: '400' }};
    --f-serif: {{ f_body }};
    --f-sans: {{ f_ui }};
    --f-logo: 'Montserrat', sans-serif;
    --f-custom-1: {{ stack_custom1 }};
    --f-custom-2: {{ stack_custom2 }};
    --page-width: {{ settings.page_width | default: '1312' }}px;
    --radius: {{ settings.radius | default: '16' }}px;
    --btn-radius: {{ btn_r }};
    --input-radius: {{ in_r }};
    --btn-case: {% if settings.button_case == 'none' %}none{% else %}uppercase{% endif %};
  }
{%- endstyle -%}
