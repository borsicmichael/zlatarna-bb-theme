{%- comment -%}
  Product card with quick add to cart.
  Params: product, hide_price (bool), hide_add (bool)
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign second = product.media[1]
-%}
<div class="card pcard">
  <a class="card__media pcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', class: 'pcard__img', widths: '300,400,600,800', sizes: '(max-width: 749px) 50vw, (max-width: 1100px) 33vw, 25vw', alt: product.featured_media.alt | default: product.title }}
      {%- if second and second.media_type == 'image' -%}
        {{ second | image_url: width: 800 | image_tag: loading: 'lazy', class: 'pcard__img pcard__img--2', widths: '300,400,600,800', sizes: '(max-width: 749px) 50vw, (max-width: 1100px) 33vw, 25vw', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-3' | placeholder_svg_tag: 'pcard__img' }}
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="pcard__badge pcard__badge--muted">{{ 'products.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="pcard__badge">{{ 'products.sale' | t }}</span>
    {%- endif -%}
  </a>
  <div class="pcard__body">
    <a class="card__title pcard__title" href="{{ product.url }}">{{ product.title | escape }}</a>
    {%- unless hide_price -%}
      <p class="card__price pcard__price">
        {%- if product.price_varies -%}
          {{ 'products.from' | t: price: product.price_min | money }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%} <s>{{ product.compare_at_price | money }}</s>{%- endif -%}
      </p>
    {%- endunless -%}
    {%- unless hide_add -%}
      {%- form 'product', product, class: 'pcard__form', novalidate: 'novalidate' -%}
        {%- if product.has_only_default_variant or product.variants.size == 1 -%}
          <input type="hidden" name="id" value="{{ v.id }}">
        {%- else -%}
          <div class="pcard__select">
            <label class="visually-hidden" for="Variant-{{ product.id }}-{{ section.id }}">{{ product.options.first | escape }}</label>
            <select id="Variant-{{ product.id }}-{{ section.id }}" name="id">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                  {{- variant.title | escape -}}{%- if product.price_varies %} · {{ variant.price | money }}{% endif -%}{%- unless variant.available %} ({{ 'products.sold_out' | t }}){% endunless -%}
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down', px: 14 %}
          </div>
        {%- endif -%}
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="pcard__add"{% unless product.available %} disabled{% endunless %}>
          {% render 'icon', name: 'cart', px: 16 %}
          <span>{%- if product.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
        </button>
      {%- endform -%}
    {%- endunless -%}
  </div>
</div>
